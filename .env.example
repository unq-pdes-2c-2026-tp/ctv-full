# ==========================================
# BACKEND CTV (Puerto 4000)
# ==========================================
MYSQL_CTV_ROOT_PASSWORD=pwdctvroot
MYSQL_CTV_DATABASE=ctv
MYSQL_CTV_USER=ctv
MYSQL_CTV_PASSWORD=ctv
MYSQL_CTV_PORT=3306

DJANGO_CTV_SECRET_KEY=super-secret-key
DJANGO_CTV_SETTINGS_MODULE=ctv.settings.production
DJANGO_CTV_PORT=4000

# ==========================================
# API VUELOS (Puerto 8000)
# ==========================================
MYSQL_VUELOS_ROOT_PASSWORD=pwdvuelosroot
MYSQL_VUELOS_DATABASE=vuelos
MYSQL_VUELOS_USER=vuelos
MYSQL_VUELOS_PASSWORD=vuelos
MYSQL_VUELOS_PORT=3307

DJANGO_VUELOS_SECRET_KEY=super-secret-key
DJANGO_VUELOS_SETTINGS_MODULE=vuelos_proj.settings.production
DJANGO_VUELOS_PORT=8000

# ==========================================
# COMUNICACIÓN INTER-SERVICIOS & FRONT
# ==========================================
# Conexión directa interna entre contenedores dentro de la red Docker
FLIGHTS_API_URL=http://vuelos:8000/api/

# Puerto expuesto del frontend
FRONTEND_PORT=80
